<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>batch-api-test-suite</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>batch-api-test-suite</name>
    <description>Serenity BDD test suite for batch jobs and APIs</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <serenity.version>5.3.3</serenity.version>
        <serenity.maven.version>5.3.10</serenity.maven.version>
        <oracle.jdbc.version>23.8.0.25.04</oracle.jdbc.version>
        <commons.exec.version>1.4.0</commons.exec.version>
        <cucumber.version>7.34.2</cucumber.version>
        <junit.platform.version>6.0.3</junit.platform.version>
        <tags/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-junit5</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay-rest</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-cucumber</artifactId>
            <version>${serenity.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-exec</artifactId>
            <version>${commons.exec.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <version>${oracle.jdbc.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <testFailureIgnore>false</testFailureIgnore>
                    <groups>${tags}</groups>
                    <systemPropertyVariables>
                        <db.kind>${db.kind}</db.kind>
                        <db.url>${db.url}</db.url>
                        <db.user>${db.user}</db.user>
                        <db.password>${db.password}</db.password>
                        <db.init>${db.init}</db.init>
                        <batch.shell.path>${batch.shell.path}</batch.shell.path>
                        <batch.log.dir>${batch.log.dir}</batch.log.dir>
                        <batch.date>${batch.date}</batch.date>
                        <batch.timeout.seconds>${batch.timeout.seconds}</batch.timeout.seconds>
                        <api.enabled>${api.enabled}</api.enabled>
                        <api.base.url>${api.base.url}</api.base.url>
                        <api.order.id>${api.order.id}</api.order.id>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>net.serenity-bdd.maven.plugins</groupId>
                <artifactId>serenity-maven-plugin</artifactId>
                <version>${serenity.maven.version}</version>
                <configuration>
                    <tags>${tags}</tags>
                </configuration>
                <executions>
                    <execution>
                        <id>serenity-reports</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>test</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <db.kind>h2</db.kind>
                <db.url>jdbc:h2:file:${project.build.directory}/test-db/reconciliation;MODE=Oracle;DATABASE_TO_UPPER=TRUE</db.url>
                <db.user>sa</db.user>
                <db.password/>
                <db.init>true</db.init>
                <batch.shell.path>${project.basedir}/scripts/run_local_reconciliation.sh</batch.shell.path>
                <batch.log.dir>${project.build.directory}/batch-logs</batch.log.dir>
                <batch.date>2026-10-31</batch.date>
                <batch.timeout.seconds>30</batch.timeout.seconds>
                <api.enabled>false</api.enabled>
                <api.base.url>http://localhost:8080</api.base.url>
                <api.order.id>1</api.order.id>
            </properties>
        </profile>

        <profile>
            <id>staging</id>
            <properties>
                <db.kind>oracle</db.kind>
                <db.init>false</db.init>
                <batch.shell.path>${env.BATCH_SHELL_PATH}</batch.shell.path>
                <batch.log.dir>${env.BATCH_LOG_DIR}</batch.log.dir>
                <batch.date>${env.BATCH_DATE}</batch.date>
                <batch.timeout.seconds>600</batch.timeout.seconds>
                <api.enabled>true</api.enabled>
                <api.base.url>${env.API_BASE_URL}</api.base.url>
                <api.order.id>${env.API_ORDER_ID}</api.order.id>
            </properties>
        </profile>
    </profiles>
</project>
