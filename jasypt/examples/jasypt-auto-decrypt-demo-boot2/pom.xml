<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>jasypt-auto-decrypt-demo-boot2</artifactId>
    <version>1.0.0</version>
    <name>jasypt-auto-decrypt-demo-boot2</name>
    <description>Spring Boot 2.7 工程引入 jasypt-spring-boot2-starter 后自动解密 ENC(...) 的示例</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 唯一与 jasypt 相关的依赖 -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>jasypt-spring-boot2-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
